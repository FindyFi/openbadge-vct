{
  "credentials": [
    {
      "id": "badge",
      "format": "dc+sd-jwt",
      "meta": {
        "vct_values": ["https://openbadge.digicredential.eu/credentials/v3/OpenBadgeVCT.json"]
      },
      "claims": [
        { "path": ["achievement", "name"] },
        { "path": ["achievement", "achievementType"], "values": ["BachelorDegree"] },
        { "path": ["source", "name"] },
        { "path": ["awardedDate"] }
      ]
    }
  ]
}
