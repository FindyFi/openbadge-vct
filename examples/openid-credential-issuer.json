{
  "credential_issuer": "https://badges.example.com",
  "authorization_servers": ["https://badges.example.com"],
  "credential_endpoint": "https://badges.example.com/credential",
  "nonce_endpoint": "https://badges.example.com/nonce",
  "display": [
    {
      "locale": "en",
      "name": "Example University",
      "logo": {
        "uri": "https://badges.example.com/images/logo.png",
        "alt_text": "Example University logo"
      }
    }
  ],
  "credential_configurations_supported": {
    "OpenBadge_dc+sd-jwt": {
      "format": "dc+sd-jwt",
      "vct": "https://openbadge.digicredential.eu/credentials/v2/OpenBadgeVCT",
      "scope": "OpenBadge",
      "cryptographic_binding_methods_supported": ["jwk"],
      "credential_signing_alg_values_supported": ["ES256"],
      "proof_types_supported": {
        "jwt": {
          "proof_signing_alg_values_supported": ["ES256"]
        }
      },
      "credential_metadata": {
        "display": [
          {
            "locale": "en",
            "name": "Open Badge",
            "description": "A verified achievement, such as a degree, course or skill.",
            "background_color": "#1f3a5f",
            "text_color": "#ffffff"
          }
        ],
        "claims": [
          {
            "path": ["achievement"],
            "mandatory": true,
            "display": [{ "locale": "en", "name": "Achievement" }]
          },
          {
            "path": ["achievement", "name"],
            "mandatory": true,
            "display": [{ "locale": "en", "name": "Achievement name" }]
          },
          {
            "path": ["achievement", "creator", "name"],
            "display": [{ "locale": "en", "name": "Awarded by" }]
          },
          {
            "path": ["awardedDate"],
            "display": [{ "locale": "en", "name": "Awarded" }]
          }
        ]
      }
    },
    "StudentStatusSdJwtVc": {
      "format": "dc+sd-jwt",
      "vct": "https://openbadge.digicredential.eu/credentials/student-status/v1/StudentStatusVCT",
      "vct#integrity": "sha256-7Jmwf4t98ylr3XSaOLcU69ht4yGoZQ72kMxZ/5MGNWM=",
      "scope": "StudentStatus",
      "cryptographic_binding_methods_supported": ["jwk"],
      "credential_signing_alg_values_supported": ["ES256"],
      "proof_types_supported": {
        "jwt": {
          "proof_signing_alg_values_supported": ["ES256"]
        }
      },
      "credential_metadata": {
        "display": [
          {
            "locale": "fi",
            "name": "Opiskelijatodiste",
            "description": "Koski-tietovarannon mukaan läsnä oleva opiskelija",
            "background_color": "#ff1493",
            "text_color": "#0d0342"
          },
          {
            "locale": "en",
            "name": "Student status",
            "description": "Enrolled as a student according to the Finnish national study records (Koski)",
            "background_color": "#ff1493",
            "text_color": "#0d0342"
          }
        ],
        "claims": [
          { "path": ["sub"], "display": [{ "locale": "fi", "name": "Oppijanumero" }, { "locale": "en", "name": "Learner number" }] },
          { "path": ["given_name"], "display": [{ "locale": "fi", "name": "Etunimet" }, { "locale": "en", "name": "Given names" }] },
          { "path": ["family_name"], "display": [{ "locale": "fi", "name": "Sukunimi" }, { "locale": "en", "name": "Family name" }] },
          { "path": ["birthdate"], "display": [{ "locale": "fi", "name": "Syntymäaika" }, { "locale": "en", "name": "Date of birth" }] },
          { "path": ["enrolment_status"], "mandatory": true, "display": [{ "locale": "fi", "name": "Opiskelutilanne" }, { "locale": "en", "name": "Enrolment status" }] },
          { "path": ["institution_name"], "mandatory": true, "display": [{ "locale": "fi", "name": "Oppilaitos" }, { "locale": "en", "name": "Institution" }] },
          { "path": ["institution_id"], "display": [{ "locale": "fi", "name": "Oppilaitoksen tunniste (OID)" }, { "locale": "en", "name": "Institution identifier (OID)" }] },
          { "path": ["institution_code"], "display": [{ "locale": "fi", "name": "Oppilaitosnumero" }, { "locale": "en", "name": "Institution number" }] },
          { "path": ["education_level"], "display": [{ "locale": "fi", "name": "Koulutusaste (koodi)" }, { "locale": "en", "name": "Level of education (code)" }] },
          { "path": ["education_level_name"], "display": [{ "locale": "fi", "name": "Koulutusaste" }, { "locale": "en", "name": "Level of education" }] },
          { "path": ["education_type"], "display": [{ "locale": "fi", "name": "Koulutusmuoto (koodi)" }, { "locale": "en", "name": "Type of education (code)" }] },
          { "path": ["education_type_name"], "display": [{ "locale": "fi", "name": "Koulutusmuoto" }, { "locale": "en", "name": "Type of education" }] },
          { "path": ["programme"], "display": [{ "locale": "fi", "name": "Koulutus" }, { "locale": "en", "name": "Programme" }] },
          { "path": ["start_date"], "display": [{ "locale": "fi", "name": "Opinnot alkaneet" }, { "locale": "en", "name": "Studies started" }] },
          { "path": ["expiry_date"], "mandatory": true, "display": [{ "locale": "fi", "name": "Voimassa asti" }, { "locale": "en", "name": "Valid until" }] },
          { "path": ["issuance_date"], "mandatory": true, "display": [{ "locale": "fi", "name": "Tilanne päivältä" }, { "locale": "en", "name": "Status as of" }] },
          { "path": ["issuing_country"], "display": [{ "locale": "fi", "name": "Myöntäjämaa" }, { "locale": "en", "name": "Issuing country" }] }
        ]
      }
    }
  }
}
